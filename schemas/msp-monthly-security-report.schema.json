{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://northsignal-labs.github.io/msp-security-reporting-template-pack/schemas/msp-monthly-security-report.schema.json",
  "title": "Northsignal Labs MSP Monthly Security Report Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_name",
    "reporting_period",
    "prepared_by",
    "overall_posture",
    "top_recommendation"
  ],
  "properties": {
    "client_name": {"type": "string", "minLength": 1},
    "reporting_period": {"type": "string", "minLength": 1},
    "prepared_by": {"type": "string", "minLength": 1},
    "overall_posture": {"type": "string", "enum": ["Green", "Amber", "Red"]},
    "top_recommendation": {"type": "string", "minLength": 1},
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "status"],
        "properties": {
          "area": {"type": "string"},
          "status": {"type": "string", "enum": ["Green", "Amber", "Red"]},
          "notes": {"type": "string"},
          "evidence_source": {"type": "string"}
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "change": {"type": "string"},
          "impact": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric"],
        "properties": {
          "metric": {"type": "string"},
          "current": {"type": ["string", "number", "integer"]},
          "target": {"type": ["string", "number", "integer"]},
          "trend": {"type": "string", "enum": ["up", "down", "flat", "new", "not_tracked"]},
          "source": {"type": "string"}
        }
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary"],
        "properties": {
          "date": {"type": "string"},
          "summary": {"type": "string"},
          "severity": {"type": "string", "enum": ["Low", "Medium", "High", "Critical"]},
          "action_taken": {"type": "string"},
          "current_status": {"type": "string"}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk"],
        "properties": {
          "risk": {"type": "string"},
          "business_impact": {"type": "string"},
          "likelihood": {"type": "string", "enum": ["Low", "Medium", "High"]},
          "owner": {"type": "string"},
          "due_date": {"type": "string"},
          "status": {"type": "string", "enum": ["open", "in_progress", "closed", "accepted", "deferred"]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item"],
        "properties": {
          "item": {"type": "string"},
          "status": {"type": "string"},
          "location": {"type": "string"}
        }
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "priority": {"type": "integer", "minimum": 1},
          "action": {"type": "string"},
          "reason": {"type": "string"},
          "owner": {"type": "string"},
          "due_date": {"type": "string"}
        }
      }
    },
    "decision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_needed"],
        "properties": {
          "decision_needed": {"type": "string"},
          "options": {"type": "string"},
          "recommendation": {"type": "string"},
          "decision_date": {"type": "string"}
        }
      }
    }
  }
}
